---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import BlogIndexPage from '@/components/blog/BlogIndexPage.astro';
---

<Layout
  title="Articles — Santiago Da Ros"
  description="Technical notes on Cloud infrastructure, governance, automation and FinOps."
  lang="en"
  alternates={{ es: '/articulos', en: '/en/articulos' }}
>
  <script>
    (window as any).__langAltUrl = { es: '/articulos' };
  </script>
  <Nav />
  <BlogIndexPage lang="en" />
  <Footer />
</Layout>
