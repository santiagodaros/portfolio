---
import Layout from '@/layouts/Layout.astro';
import CommunityPage from '@/components/community/CommunityPage.astro';
import { communityText, hubHref } from '@/i18n/community';
const t = communityText['es'].hub;
---

<Layout
  title={t.metaTitle}
  description={t.metaDescription}
  lang="es"
  alternates={{ es: hubHref('es'), en: hubHref('en') }}
>
  <CommunityPage lang="es" />
</Layout>
