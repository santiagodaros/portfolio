---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ArticlePage from '@/components/blog/ArticlePage.astro';
import { getSeriesInfo, getTranslation } from '@/lib/blog';
import { articleJsonLd, personJsonLd } from '@/lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('blog', (e) => e.data.lang === 'es' && !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}
const { entry } = Astro.props;
const translation = await getTranslation(entry);

const canonicalUrl = new URL(`/articulos/${entry.slug}/`, Astro.site).toString();
const alternates: Partial<Record<'es' | 'en', string>> = { es: `/articulos/${entry.slug}/` };
if (translation) alternates.en = `/en/articulos/${translation.slug}/`;

const series = await getSeriesInfo(entry);
const jsonLd = articleJsonLd(entry, canonicalUrl, Astro.site!, series);
const person = { '@context': 'https://schema.org', ...personJsonLd(entry.data.lang, Astro.site!) };
---

<Layout
  title={`${entry.data.title} — Santiago Da Ros`}
  description={entry.data.description}
  lang="es"
  type="article"
  ogImagePath={`/og/${entry.slug}.png`}
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated}
  canonical={entry.data.canonical}
  alternates={alternates}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
  <ArticlePage entry={entry} />
</Layout>
