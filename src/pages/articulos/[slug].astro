---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ArticlePage from '@/components/blog/ArticlePage.astro';
import { getTranslation } from '@/lib/blog';

export async function getStaticPaths() {
  const entries = await getCollection('blog', (e) => e.data.lang === 'es' && !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}
const { entry } = Astro.props;
const translation = await getTranslation(entry);

const canonicalUrl = new URL(`/articulos/${entry.slug}/`, Astro.site).toString();
const alternates: Partial<Record<'es' | 'en', string>> = { es: `/articulos/${entry.slug}/` };
if (translation) alternates.en = `/en/articulos/${translation.slug}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
  inLanguage: entry.data.lang,
  mainEntityOfPage: canonicalUrl,
  image: new URL(`/og/${entry.slug}.png`, Astro.site).toString(),
  author: {
    '@type': 'Person',
    name: 'Santiago Lucas Da Ros',
    url: 'https://www.linkedin.com/in/santiagodaros',
  },
};
---

<Layout
  title={`${entry.data.title} — Santiago Da Ros`}
  description={entry.data.description}
  lang="es"
  type="article"
  ogImagePath={`/og/${entry.slug}.png`}
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated}
  alternates={alternates}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <ArticlePage entry={entry} translation={translation} />
</Layout>
