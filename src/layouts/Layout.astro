---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Sprite from '../components/Sprite.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { otherLang, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  type?: 'website' | 'article';
  ogImagePath?: string;
  ogImageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** URL canónica externa, si la página se publicó antes en otro sitio (p. ej. un artículo de LinkedIn). */
  canonical?: string;
  /** Páginas que no deben indexarse (p. ej. la de gracias del newsletter). */
  noindex?: boolean;
  /** URLs reales por idioma de esta página, p. ej. { es: '/articulos/x', en: '/en/articulos/y' }.
   *  Sin esto, la página no tiene traducción: no se muestra el botón de idioma y el hreflang apunta a sí misma. */
  alternates?: Partial<Record<Lang, string>>;
}

const {
  title = 'Santiago Da Ros: ingeniero de producto y cloud en Azure',
  description = 'Santiago Da Ros, ingeniero cloud que construye producto. Herramientas sobre Azure para portales, automatización, gobernanza y recuperación ante desastres, con IA en el flujo de trabajo.',
  lang = 'es',
  type = 'website',
  ogImagePath: ogImagePathProp,
  ogImageAlt: ogImageAltProp,
  publishedTime,
  modifiedTime,
  canonical,
  noindex = false,
  alternates,
} = Astro.props;

// Imagen para redes: la de la home en el idioma de la página, salvo que la página traiga la suya (artículos)
const ogImagePath = ogImagePathProp ?? (lang === 'en' ? '/og-en.png' : '/og.png');
const ogImageAlt =
  ogImageAltProp ??
  (lang === 'en'
    ? 'Santiago Da Ros presenting, next to the title From cloud to product'
    : 'Santiago Da Ros presentando, junto al título De cloud al producto');
const ogImage = new URL(ogImagePath, Astro.site);
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const canonicalUrl = canonical ? new URL(canonical) : pageUrl;

const hreflangLinks = alternates
  ? Object.entries(alternates).map(([hreflang, href]) => ({
      hreflang,
      href: new URL(href, Astro.site).toString(),
    }))
  : [{ hreflang: lang, href: pageUrl.toString() }];
const xDefaultHref = alternates?.es ? new URL(alternates.es, Astro.site).toString() : pageUrl.toString();
const alternateHref = alternates?.[otherLang(lang)];
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Antes de pintar: marca que hay JS y fija el tema.
      // Preferencia guardada → preferencia del sistema → claro.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null;
        try {
          t = localStorage.getItem('sdr-theme');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        d.setAttribute('data-theme', t);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Santiago Da Ros" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1f2de6" />
    <link rel="canonical" href={canonicalUrl} />
    {hreflangLinks.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Santiago Da Ros" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_AR'} />
    {
      type === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      type === 'article' && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Santiago Da Ros — Blog"
      href={lang === 'en' ? '/en/rss.xml' : '/rss.xml'}
    />
    <Analytics />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Sprite />
    <Nav lang={lang} alternateHref={alternateHref} search />
    <slot />
    <Footer lang={lang} />
    <CommandPalette lang={lang} alternateHref={alternateHref} />

    <script>
      // Animación de entrada del logo (el timeout cubre pestañas donde rAF está en pausa)
      const markLoaded = () => document.documentElement.classList.add('loaded');
      requestAnimationFrame(markLoaded);
      setTimeout(markLoaded, 80);

      // Aparición al hacer scroll. Solo se oculta con JS (html.js) y sin movimiento reducido.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        items.forEach((el, i) => {
          // Las grillas de tarjetas entran escalonadas, de a tres
          const staggered = el.matches('.sol, .talk, .pillar, .group');
          el.style.transitionDelay = `${(staggered ? i % 3 : 0) * 80}ms`;
          io.observe(el);
        });
      }

      // El email no está en el HTML estático: se arma en el cliente para que no lo cosechen bots.
      const email = atob('c2FudGlhZ29sdWNhc2Rhcm9zQGdtYWlsLmNvbQ==');
      document.querySelectorAll<HTMLAnchorElement>('a[data-link="email"]').forEach((a) => {
        a.href = `mailto:${email}`;
      });
    </script>
  </body>
</html>
