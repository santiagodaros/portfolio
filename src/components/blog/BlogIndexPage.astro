---
import { formatDate, getBlogIndex } from '../../lib/blog';
import { blogText, tagLabel } from '../../i18n/blog';
import { homePath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = blogText[lang];
const items = await getBlogIndex(lang);
---

<main id="main" tabindex="-1" class="reader">
  <header class="reader__top">
    <div class="reader__wrap reader__topbar">
      <a class="link" href={homePath(lang)}>{t.index.backHome}</a>
      <span class="muted">{t.index.crumb}</span>
    </div>
  </header>

  <div class="reader__wrap">
    {t.index.note && <p class="en-note">{t.index.note}</p>}
    <h1>{t.index.title}</h1>
    <p class="reader__lead">{t.index.lead}</p>

    <div class="index">
      {
        items.map((i) => (
          <article class="index__item">
            <div class="meta">
              <span class="tag">{tagLabel(i.tag, lang)}</span>
              <span>{formatDate(i.date, lang)}</span>
              <span>{t.kinds[i.kind]}</span>
            </div>
            <h2>
              <a
                class="index__link"
                href={i.href}
                {...(i.external ? { target: '_blank', rel: 'noopener' } : {})}
                {...(i.inSpanish ? { hreflang: 'es' } : {})}
              >
                {i.title}
              </a>
            </h2>
            <p class="muted">{i.summary}</p>
            {i.extended && (
              <a class="link index__ext" href={i.extended.href} {...(i.inSpanish ? { hreflang: 'es' } : {})}>
                {t.extendedLink}
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</main>

<style>
  .reader h1 {
    margin-top: 56px;
  }
  .en-note + h1 {
    margin-top: 40px;
  }
  .index {
    display: grid;
    margin: 40px 0 96px;
  }
  .index__item {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  /* Toda la fila es clickeable (enlace estirado), con un link secundario aparte */
  .index__link {
    color: inherit;
    text-decoration: none;
  }
  .index__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .index__ext {
    position: relative;
    z-index: 1;
    justify-self: start;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    font-size: 14px;
    color: var(--muted);
  }
  .meta .tag {
    color: var(--accent);
  }
  .index__item h2 {
    font-size: 26px;
    line-height: 1.2;
    transition: color 0.15s;
  }
  .index__item:hover h2,
  .index__link:focus-visible {
    color: var(--accent);
  }
</style>
