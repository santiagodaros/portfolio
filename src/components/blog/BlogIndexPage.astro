---
import { formatDate, getBlogIndex } from '../../lib/blog';
import { blogText, tagLabel } from '../../i18n/blog';
import { homePath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = blogText[lang];
const items = await getBlogIndex(lang);
---

<main class="reader">
  <header class="reader__top">
    <div class="reader__wrap reader__topbar">
      <a class="link" href={homePath(lang)}>{t.index.backHome}</a>
      <span class="muted">{t.index.crumb}</span>
    </div>
  </header>

  <div class="reader__wrap">
    {t.index.note && <p class="en-note">{t.index.note}</p>}
    <h1>{t.index.title}</h1>
    <p class="reader__lead">{t.index.lead}</p>

    <div class="index">
      {
        items.map((i) => (
          <a
            class="index__item"
            href={i.href}
            {...(i.external ? { target: '_blank', rel: 'noopener' } : {})}
            {...(i.inSpanish ? { hreflang: 'es' } : {})}
          >
            <div class="meta">
              <span class="tag">{tagLabel(i.tag, lang)}</span>
              <span>{formatDate(i.date, lang)}</span>
              <span>{t.kinds[i.kind]}</span>
            </div>
            <h2>{i.title}</h2>
            <p class="muted">{i.summary}</p>
          </a>
        ))
      }
    </div>
  </div>
</main>

<style>
  .reader__top {
    border-bottom: 1px solid var(--line);
  }
  .reader__wrap {
    width: min(100% - 40px, 720px);
    margin-inline: auto;
  }
  .reader__topbar {
    height: 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
  }
  .en-note {
    margin: 28px 0 0;
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--tonal);
    color: var(--tonal-ink);
    font-size: 14px;
  }
  h1 {
    margin-top: 56px;
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.05;
  }
  .reader__lead {
    margin-top: 20px;
    font-size: 20px;
    line-height: 1.55;
    color: var(--muted);
  }
  .en-note + h1 {
    margin-top: 40px;
  }
  .index {
    display: grid;
    margin: 40px 0 96px;
  }
  .index__item {
    display: grid;
    gap: 8px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    font-size: 14px;
    color: var(--muted);
  }
  .meta .tag {
    color: var(--accent);
  }
  .index__item h2 {
    font-size: 26px;
    line-height: 1.2;
    transition: color 0.15s;
  }
  .index__item:hover h2 {
    color: var(--accent);
  }
</style>
