---
import type { CollectionEntry } from 'astro:content';
import { getReadingTime, formatDate } from '@/lib/blog';

interface Props {
  entry: CollectionEntry<'blog'>;
  lang: 'es' | 'en';
}
const { entry, lang } = Astro.props;
const href = lang === 'es' ? `/articulos/${entry.slug}` : `/en/articulos/${entry.slug}`;
const minutes = getReadingTime(entry.body);
---

<div class="grid lg:grid-cols-[1fr_260px] gap-5 animate-on-scroll">
  <a href={href} class="box-alt p-7 sm:p-8 flex flex-col justify-center hover:border-accent transition-colors">
    <div
      class="inline-flex items-center gap-[7px] font-mono font-bold text-[11px] text-accent border px-2 py-[3px] mb-4 w-fit"
      style="border-color: rgb(var(--color-accent) / 0.4)"
    >
      <span class="pulse-square w-1.5 h-1.5 bg-accent"></span>
      {lang === 'es' ? 'destacado' : 'featured'}
    </div>
    <div class="flex flex-wrap gap-2 mb-3">
      {entry.data.tags.slice(0, 4).map((tag) => <span class="chip">#{tag}</span>)}
    </div>
    <h2 class="font-serif text-2xl sm:text-[28px] text-text-primary leading-tight">{entry.data.title}</h2>
    <p class="mt-3 font-mono text-sm leading-relaxed text-text-secondary max-w-[62ch]">
      {entry.data.description}
    </p>
    <div class="mt-5 font-mono text-[11px] text-text-muted">
      {formatDate(entry.data.date, lang)} · {minutes} min
    </div>
  </a>

  <div class="box p-5 font-mono text-[11px] text-text-muted flex flex-col justify-between">
    <div>
      <p class="text-accent mb-2">$ cat metadata.json</p>
      <pre class="whitespace-pre-wrap leading-relaxed text-text-secondary">{`{
  "category": "${entry.data.category}",
  "lang": "${entry.data.lang}",
  "reading_time": "${minutes}m"
}`}</pre>
    </div>
    <span class="pulse-square w-1.5 h-1.5 bg-tgreen mt-4"></span>
  </div>
</div>
