---
// Recuadro dentro de un artículo MDX. `info` no lleva etiqueta; las demás variantes sí,
// para que el significado no dependa solo del color.
import { blogText } from '../../i18n/blog';
import type { Lang } from '../../i18n';

interface Props {
  variant?: 'info' | 'tip' | 'warning' | 'danger';
  /** Por defecto 'es': pasar lang="en" en el contenido MDX en inglés. */
  lang?: Lang;
}
const { variant = 'info', lang = 'es' } = Astro.props;
const label = variant === 'info' ? undefined : blogText[lang].article.calloutLabels[variant];
---

<aside class:list={['callout', `callout--${variant}`]}>
  {label && <p class="callout__label">{label}</p>}
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    margin: 30px 0;
    padding: 20px 22px;
    border-left: 3px solid var(--accent);
    border-radius: 0 14px 14px 0;
    background: var(--tonal);
    color: var(--tonal-ink);
  }
  .callout__label {
    margin: 0 0 6px !important;
    font: 500 12px/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .callout__body :global(p) {
    margin: 0;
  }
  .callout__body :global(p + p) {
    margin-top: 0.75em;
  }
  .callout--tip {
    border-left-color: var(--ok);
    background: var(--ok-bg);
    color: var(--ok);
  }
  .callout--warning {
    border-left-color: #d97706;
    background: #fef3c7;
    color: #92400e;
  }
  .callout--danger {
    border-left-color: #e5484d;
    background: #fde8e8;
    color: #9b1c1c;
  }
  :global([data-theme='dark']) .callout--warning {
    background: rgb(245 158 11 / 0.15);
    color: #fbbf24;
  }
  :global([data-theme='dark']) .callout--danger {
    background: rgb(229 72 77 / 0.16);
    color: #ff9ea1;
  }
</style>
