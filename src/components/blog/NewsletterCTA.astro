---
// Static shell for Phase 1/2 — the submit handler below is a placeholder.
// Phase 3 swaps it for a client-side POST to MailerLite/Beehiiv's public
// API (no backend endpoint: the site stays 100% static, per decision #3).
interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
---

<div class="box-alt p-7 sm:p-8">
  <p class="font-mono text-xs text-accent mb-3">$ subscribe --newsletter</p>
  <h3 class="font-serif text-2xl text-text-primary">
    {lang === 'es' ? 'Un análisis por semana' : 'One deep-dive a week'}
  </h3>
  <p class="mt-2 font-mono text-[13px] text-text-secondary max-w-[56ch]">
    {
      lang === 'es'
        ? 'Casos reales de infraestructura, governance y automatización. Sin spam, cancelás cuando quieras.'
        : 'Real infrastructure, governance and automation cases. No spam, unsubscribe anytime.'
    }
  </p>
  <form
    class="mt-5 flex flex-col sm:flex-row gap-3 max-w-[440px]"
    data-newsletter-form
    aria-label={lang === 'es' ? 'Suscripción al newsletter' : 'Newsletter signup'}
  >
    <label class="sr-only" for="newsletter-email">Email</label>
    <input
      id="newsletter-email"
      type="email"
      required
      placeholder="tu@email.com"
      class="flex-1 bg-surface-2 border border-border px-3.5 py-2.5 font-mono text-[13px] text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent transition-colors"
    />
    <button type="submit" class="btn-solid whitespace-nowrap">
      {lang === 'es' ? 'Suscribirme →' : 'Subscribe →'}
    </button>
  </form>
  <p
    class="mt-3 font-mono text-[11px] text-text-muted"
    data-newsletter-status
    data-msg={lang === 'es' ? 'Newsletter aún no conectado — próximamente.' : 'Newsletter not connected yet — coming soon.'}
    role="status"
    aria-live="polite"
  ></p>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const status = form.parentElement?.querySelector<HTMLElement>('[data-newsletter-status]');
      if (status) status.textContent = status.dataset.msg ?? '';
    });
  });
</script>
