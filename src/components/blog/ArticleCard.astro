---
import type { CollectionEntry } from 'astro:content';
import { getReadingTime, formatDate } from '@/lib/blog';

interface Props {
  entry: CollectionEntry<'blog'>;
  lang: 'es' | 'en';
}
const { entry, lang } = Astro.props;
const href = lang === 'es' ? `/articulos/${entry.slug}` : `/en/articulos/${entry.slug}`;
const minutes = getReadingTime(entry.body);
---

<a
  href={href}
  class="group box p-5 flex flex-col hover:border-accent hover:-translate-y-0.5 transition-all duration-200 animate-on-scroll"
>
  <div class="flex flex-wrap gap-2 mb-3">
    {entry.data.tags.slice(0, 3).map((tag) => <span class="chip">#{tag}</span>)}
  </div>
  <h3 class="font-serif text-lg text-text-primary leading-snug group-hover:text-accent transition-colors">
    {entry.data.title}
  </h3>
  <p class="mt-2 font-mono text-[13px] leading-relaxed text-text-secondary line-clamp-3">
    {entry.data.description}
  </p>
  <div class="mt-4 pt-3 border-t border-border flex justify-between items-center font-mono text-[11px] text-text-muted">
    <span>{formatDate(entry.data.date, lang)}</span>
    <span>{minutes} min</span>
  </div>
</a>
