---
import type { CollectionEntry } from 'astro:content';
import References from './References.astro';
import Callout from './Callout.astro';
import PullQuote from './PullQuote.astro';
import Takeaway from './Takeaway.astro';
import { articleHref, formatDate, getNextArticle, getReadingTime } from '../../lib/blog';
import { blogText } from '../../i18n/blog';
import { homePath, paths } from '../../i18n';

interface Props {
  entry: CollectionEntry<'blog'>;
}
const { entry } = Astro.props;
const lang = entry.data.lang;
const t = blogText[lang].article;
const { Content } = await entry.render();
const minutes = getReadingTime(entry.body);
const next = await getNextArticle(entry);
---

<main class="reader">
  <div class="reader__progress" aria-hidden="true"><i></i></div>
  <header class="reader__top">
    <div class="reader__wrap reader__topbar">
      <a class="link" href={paths[lang].blog}>{t.back}</a>
      <span class="muted">{t.readTime(minutes)}</span>
    </div>
  </header>

  <article class="reader__wrap" data-article>
    <div class="reader__meta">
      <span class="tag">{entry.data.category}</span>
      <span>{formatDate(entry.data.date, lang)}</span>
      {entry.data.updated && <span>· {t.updated} {formatDate(entry.data.updated, lang)}</span>}
    </div>
    <h1>{entry.data.title}</h1>
    <p class="reader__lead">{entry.data.description}</p>
    {
      entry.data.cover && (
        <img class="reader__img" src={entry.data.cover} alt={entry.data.coverAlt ?? ''} width="1600" height="560" />
      )
    }
    {
      !entry.data.cover && entry.data.coverCode && (
        <div class="reader__cover" aria-hidden="true"><code>{entry.data.coverCode}</code></div>
      )
    }

    <div class="prose" data-copy={t.copy} data-copied={t.copied} data-copy-fail={t.copyFail}>
      <Content components={{ Callout, PullQuote, Takeaway }} />
    </div>

    <References references={entry.data.references} lang={lang} />

    <footer class="reader__end">
      <div class="author">
        <img src="/img/retrato.webp" alt="" width="56" height="56" />
        <div>
          <b>{t.authorName}</b>
          <span class="muted">{t.authorRole}</span>
        </div>
      </div>
      <div class="reader__actions">
        {
          entry.data.linkedin && (
            <a class="btn btn--primary" href={entry.data.linkedin} target="_blank" rel="noopener">
              {t.comment}
            </a>
          )
        }
        <a class="btn btn--secondary" href={`${homePath(lang)}#newsletter`}>{t.subscribe}</a>
      </div>
      {
        next && (
          <a class="next replica" href={articleHref(next)}>
            <span class="muted">{t.next}</span>
            <b>{next.data.title}</b>
          </a>
        )
      }
    </footer>
  </article>
</main>

<style>
  .reader__progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 30;
  }
  .reader__progress i {
    display: block;
    width: 0;
    height: 100%;
    background: var(--accent);
  }
  .reader__top {
    border-bottom: 1px solid var(--line);
  }
  .reader__wrap {
    width: min(100% - 40px, 720px);
    margin-inline: auto;
  }
  .reader__topbar {
    height: 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
  }
  .reader__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin: 56px 0 18px;
    font-size: 14px;
    color: var(--muted);
  }
  .reader__meta .tag {
    color: var(--accent);
  }
  .reader h1 {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.05;
  }
  .reader__lead {
    margin-top: 20px;
    font-size: 20px;
    line-height: 1.55;
    color: var(--muted);
  }
  .reader__img {
    display: block;
    width: 100%;
    height: auto;
    margin: 36px 0 8px;
    border-radius: 20px;
  }
  .reader__cover {
    position: relative;
    margin: 36px 0 8px;
    padding: 32px;
    overflow: auto;
    border-radius: 20px;
    background: var(--ink);
    color: #c9cdd4;
    font: 400 14px/1.7 var(--mono);
    white-space: pre;
  }
  .reader__cover::after {
    content: '';
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--accent);
  }
  :global([data-theme='dark']) .reader__cover {
    background: #000;
  }
  .reader__end {
    margin: 64px 0 96px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 24px;
  }
  .author {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .author img {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .author div {
    display: grid;
    gap: 2px;
  }
  .author span {
    font-size: 14px;
  }
  .reader__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .next {
    display: grid;
    gap: 4px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
  }
  .next b {
    font: 500 21px/1.25 var(--display);
    letter-spacing: -0.03em;
  }
  .next:hover b {
    color: var(--accent);
  }
</style>

<style is:global>
  /* Cuerpo del artículo (MDX) */
  .prose {
    font-size: 18px;
    line-height: 1.75;
  }
  .prose p,
  .prose ul,
  .prose ol {
    margin: 22px 0;
  }
  .prose h2 {
    margin: 52px 0 0;
    font-size: 28px;
    line-height: 1.15;
    scroll-margin-top: 88px;
  }
  .prose h3 {
    margin: 36px 0 0;
    font-size: 22px;
    line-height: 1.2;
    scroll-margin-top: 88px;
  }
  .prose ul,
  .prose ol {
    padding-left: 1.6em;
  }
  .prose ul {
    list-style: disc;
  }
  .prose ol {
    list-style: decimal;
  }
  .prose li {
    margin: 10px 0;
    padding-left: 4px;
  }
  .prose li::marker {
    color: var(--accent);
  }
  .prose strong {
    font-weight: 600;
  }
  .prose a {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  .prose sup a {
    text-decoration: none;
    font-weight: 600;
  }
  .prose :not(pre) > code {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--surface);
    font: 400 0.85em/1 var(--mono);
  }
  .prose hr {
    margin: 40px 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
  .prose blockquote:not(.pullquote) {
    margin: 26px 0;
    padding-left: 20px;
    border-left: 3px solid var(--line);
    color: var(--muted);
  }
  .prose table {
    width: 100%;
    margin: 26px 0;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.5;
    display: block;
    overflow-x: auto;
  }
  .prose th,
  .prose td {
    padding: 10px 14px;
    border: 1px solid var(--line);
    text-align: left;
  }
  .prose th {
    background: var(--surface);
    font-weight: 500;
  }
  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 14px;
  }

  /* Bloques de código: el script de ArticlePage les agrega la barra con "Copiar" */
  .prose pre {
    margin: 26px 0;
    padding: 18px;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #0b0c0e !important;
    font: 400 13.5px/1.65 var(--mono);
    color: #e6e8eb;
  }
  .prose pre code {
    background: none;
    padding: 0;
    font: inherit;
  }
  .code {
    margin: 26px 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #0b0c0e;
  }
  .code pre {
    margin: 0;
    border: 0;
    border-radius: 0;
  }
  .code__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 10px 8px 16px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    font: 400 12px/1 var(--mono);
    color: #9aa0a8;
  }
  .code__copy {
    min-height: 32px;
    padding: 8px 12px;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    color: #eef0f3;
    font: 500 12px/1 var(--text);
    cursor: pointer;
  }
  .code__copy:hover {
    background: rgb(255 255 255 / 0.14);
  }
</style>

<script>
  // Barra de código con "Copiar" en cada bloque (mejora progresiva: sin JS el bloque se ve igual)
  const prose = document.querySelector<HTMLElement>('.prose');
  prose?.querySelectorAll<HTMLPreElement>('pre').forEach((pre) => {
    const lang = pre.dataset.language;
    const wrap = document.createElement('div');
    wrap.className = 'code';
    const bar = document.createElement('div');
    bar.className = 'code__bar';
    const label = document.createElement('span');
    label.textContent = !lang || lang === 'plaintext' ? 'TEXT' : lang.toUpperCase();
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code__copy';
    btn.textContent = prose.dataset.copy ?? 'Copy';
    btn.addEventListener('click', async () => {
      const text = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
      let msg = prose.dataset.copied ?? 'Copied';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        msg = prose.dataset.copyFail ?? 'Select and copy';
      }
      btn.textContent = msg;
      setTimeout(() => (btn.textContent = prose.dataset.copy ?? 'Copy'), 1600);
    });
    bar.append(label, btn);
    pre.replaceWith(wrap);
    wrap.append(bar, pre);
  });

  // Barra de progreso de lectura
  const article = document.querySelector<HTMLElement>('[data-article]');
  const bar = document.querySelector<HTMLElement>('.reader__progress i');
  function progress() {
    if (!article || !bar) return;
    const top = article.getBoundingClientRect().top + scrollY;
    const total = article.offsetHeight - innerHeight;
    bar.style.width = `${total > 0 ? Math.min(100, Math.max(0, ((scrollY - top) / total) * 100)) : 0}%`;
  }
  addEventListener('scroll', progress, { passive: true });
  progress();
</script>
