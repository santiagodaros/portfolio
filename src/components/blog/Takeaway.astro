---
import { blogText } from '../../i18n/blog';
import type { Lang } from '../../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
---

<aside class="takeaway">
  <p class="takeaway__label">{blogText[lang].article.takeaway}</p>
  <div class="takeaway__body"><slot /></div>
</aside>

<style>
  .takeaway {
    margin: 30px 0;
    padding: 20px 22px;
    border: 1px solid var(--accent);
    border-radius: 14px;
    background: var(--card);
  }
  .takeaway__label {
    margin: 0 0 8px !important;
    font: 500 12px/1 var(--mono);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .takeaway__body :global(p) {
    margin: 0;
  }
  .takeaway__body :global(p + p) {
    margin-top: 0.75em;
  }
</style>
