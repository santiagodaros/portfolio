---
import ReaderPage from './ReaderPage.astro';
import { pagesText } from '../i18n/pages';
import { homePath, type Lang } from '../i18n';
import { certs } from '../i18n/home';
import { countLastYear, getContributions } from '../lib/contributions';
import { getNextTalkPhrases } from '../lib/talks';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = pagesText[lang];
const s = t.status;
const groups = [s.resolved, s.planned];
// Las notas de estas filas salen de los datos: certificaciones, próxima charla y contribuciones
const nextTalk = await getNextTalkPhrases(lang);
const total = countLastYear(await getContributions(lang)).total;
const noTalk = lang === 'es' ? 'Sin charlas confirmadas por ahora' : 'No confirmed talks for now';
const fill = (note: string) =>
  note
    .replace('{certs}', String(certs.length))
    .replace('{talk}', nextTalk?.status ?? noTalk)
    .replace('{contributions}', String(total));
---

<ReaderPage backHref={homePath(lang)} backLabel={t.back} crumb={s.crumb}>
  <div class="reader__meta">
    <span class="tag">{s.tag}</span>
    <span>{s.date}</span>
  </div>
  <h1>{s.title}</h1>
  <div class="banner-ok"><span class="dot"></span>{s.banner}</div>
  <div class="up">
    {
      s.rows.map((r) => (
        <div class="up__row">
          <div class="up__head">
            <b>{r.name}</b>
            <span class:list={['st', `st--${r.tone}`]}>{r.state}</span>
          </div>
          <span class="muted up__note">{fill(r.note)}</span>
        </div>
      ))
    }
  </div>
  <div class="prose">
    {
      groups.map((g) => (
        <>
          <h2>{g.title}</h2>
          <div class="log">
            {g.items.map((i) => (
              <div class="log__item">
                <time>{i.time}</time>
                <b>{i.title}</b>
                <p>{i.text}</p>
              </div>
            ))}
          </div>
        </>
      ))
    }
  </div>
</ReaderPage>

<style>
  .banner-ok {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 28px 0 12px;
    padding: 18px 20px;
    border-radius: 14px;
    background: var(--ok-bg);
    color: var(--ok);
    font-weight: 500;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a36a;
  }
  .up {
    display: grid;
    margin-top: 20px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card);
  }
  .up__row {
    display: grid;
    gap: 10px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
  }
  .up__row:last-child {
    border-bottom: 0;
  }
  .up__head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .up__head b {
    font-weight: 500;
  }
  .st {
    font-size: 13px;
    font-weight: 500;
  }
  .st--ok {
    color: var(--ok);
  }
  .st--maint {
    color: var(--accent);
  }
  .up__note {
    font-size: 13px;
  }
  .log {
    display: grid;
    margin: 20px 0;
  }
  .log__item {
    display: grid;
    gap: 4px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .log__item time {
    font: 400 13px/1 var(--mono);
    color: var(--muted);
  }
  .log__item b {
    font: 500 19px/1.3 var(--display);
  }
  .log__item p {
    margin: 2px 0 0;
    font-size: 16px;
    color: var(--muted);
  }
</style>
