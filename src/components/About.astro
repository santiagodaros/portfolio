---
import { home } from '../i18n/home';
import { contact, paths, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = home[lang].about;
---

<section id="sobre-mi" class="section ground-surface">
  <div class="wrap about">
    <figure class="about__photo ph" data-reveal>
      <img src="/img/retrato.webp" alt={t.photoAlt} width="800" height="1000" loading="lazy" />
    </figure>
    <div class="about__text">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2>{t.title}</h2>
      <p>{t.p1}</p>
      <p>{t.p2}</p>
      <div class="btn-row">
        <a class="btn btn--secondary" href={paths[lang].cv} target="_blank" rel="noopener">{t.cvBtn}</a>
        <a class="btn btn--secondary" href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
    <ol class="timeline" data-reveal>
      {
        t.timeline.map((e) => (
          <li>
            <time>{e.time}</time>
            <b>{e.title}</b>
            <span>{e.text}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: center;
  }
  .about__photo {
    grid-column: span 4;
  }
  .about__photo img {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .about__text {
    grid-column: 5 / span 4;
    display: grid;
    gap: 18px;
  }
  .about__text h2 {
    font-size: var(--t2);
    line-height: 1.06;
  }
  .about__text p {
    font-size: 18px;
    color: var(--muted);
  }
  .timeline {
    grid-column: 9 / span 4;
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--line);
  }
  .timeline li {
    position: relative;
    display: grid;
    gap: 4px;
    padding: 0 0 26px 24px;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .timeline time {
    font: 400 13px/1 var(--mono);
    color: var(--muted);
  }
  .timeline b {
    font: var(--display-weight) 20px/1.2 var(--display);
  }
  .timeline span {
    color: var(--muted);
    font-size: 15px;
  }

  @media (max-width: 1023px) {
    .about__photo {
      grid-column: 1 / span 6;
    }
    .about__text,
    .timeline {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 639px) {
    .about__photo {
      grid-column: 1 / -1;
      max-width: 320px;
    }
  }
</style>
