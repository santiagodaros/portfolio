---
// Bloque de código con barra y botón "Copiar" (renderizado en el servidor; el botón se activa con JS).
interface Props {
  label: string;
  code: string;
  copy: string;
  copied: string;
  copyFail: string;
}
const { label, code, copy, copied, copyFail } = Astro.props;
---

<div class="code">
  <div class="code__bar">
    <span>{label}</span>
    <button type="button" class="code__copy" data-code-copy data-copy={copy} data-copied={copied} data-copy-fail={copyFail}>{copy}</button>
  </div>
  <pre><code>{code}</code></pre>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-code-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.closest('.code')?.querySelector('code')?.textContent ?? '';
      let msg = btn.dataset.copied ?? 'Copied';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        msg = btn.dataset.copyFail ?? 'Select and copy';
      }
      btn.textContent = msg;
      setTimeout(() => (btn.textContent = btn.dataset.copy ?? 'Copy'), 1600);
    });
  });
</script>
