---
import { certInProgress, certs, home } from '../i18n/home';
import type { Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = home[lang].stack;
---

<section id="stack" class="section">
  <div class="wrap">
    <div class="head" data-reveal>
      <div>
        <span class="eyebrow">{t.eyebrow}</span>
        <h2>{t.title}</h2>
      </div>
      <p>{t.note}</p>
    </div>
    <div class="stack">
      <div class="stack__groups">
        {
          t.groups.map((g) => (
            <div class="group replica" data-reveal>
              <h3>{g.title}</h3>
              <ul>
                {g.items.map((i) => (
                  <li>
                    {i.text}
                    {'badge' in i && <span>{i.badge}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="certs" data-reveal>
        <h3>{t.certsTitle}</h3>
        {
          certs.map((c) => (
            <a
              class="cert"
              href={c.url}
              target="_blank"
              rel="noopener"
            >
              <img src={`/img/badges/${c.badge}.png`} alt="" width="58" height="60" loading="lazy" />
              <span>
                <b>{c.code}</b> · {c.level}
              </span>
              <small>{c.name}</small>
              <span class="sr-only">, {t.verifyHint}</span>
              <i class="cert__go" aria-hidden="true">↗</i>
            </a>
          ))
        }
        <div class="cert cert--next">
          <img
            class="cert__pending"
            src={`/img/badges/${certInProgress.badge}.png`}
            alt=""
            width="58"
            height="60"
            loading="lazy"
          />
          <span>
            <b>{certInProgress.code}</b> · {t.inProgress}
          </span>
          <small>{certInProgress.name}</small>
        </div>
        <p class="certs__note">{t.certsNote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .stack {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
  }
  .stack__groups {
    grid-column: span 8;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-content: start;
    align-self: start;
  }
  .group {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 22px;
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .group h3 {
    font-size: var(--t4);
  }
  .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .group li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
  }
  .group li span {
    margin-left: auto;
    font: 400 12px/1 var(--mono);
    color: var(--muted);
  }
  .certs {
    grid-column: 9 / span 4;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 26px;
    border-radius: 18px;
    background: var(--ink);
    color: var(--bg);
  }
  .certs h3 {
    font-size: var(--t4);
    color: var(--bg);
    margin-bottom: 10px;
  }
  .cert {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 0 14px;
    align-items: center;
    padding: 10px 0;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    text-decoration: none;
    color: inherit;
  }
  .cert img {
    grid-row: 1 / span 2;
    width: 44px;
    height: auto;
  }
  .cert span {
    font-size: 15px;
  }
  .cert span b {
    font: 500 14px/1 var(--mono);
  }
  .cert small {
    grid-column: 2;
    font-size: 13px;
    opacity: 0.7;
  }
  .cert__go {
    grid-row: 1 / span 2;
    grid-column: 3;
    font-style: normal;
    opacity: 0.4;
    transition:
      opacity 0.15s,
      transform 0.15s;
  }
  a.cert:hover .cert__go {
    opacity: 1;
    transform: translate(2px, -2px);
  }
  a.cert:hover span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cert__pending {
    filter: grayscale(1);
    opacity: 0.35;
  }
  .certs__note {
    font-size: 12px;
    opacity: 0.6;
    margin-top: 6px;
  }

  @media (max-width: 1023px) {
    .stack__groups,
    .certs {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 639px) {
    .stack__groups {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  [data-theme='dark'] .certs .cert {
    border-color: rgb(0 0 0 / 0.14);
  }
</style>
