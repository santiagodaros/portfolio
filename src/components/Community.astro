---
// Sección "Comunidad" de la home: la misma lista visual que el hub /comunidad (pestañas con cantidad, tarjetas de
// charlas, artículos, posts y código), resumida; las pestañas filtran en el lugar y "Ver todo" despliega.
// Debajo, la guía gratuita de KQL.
import CommunityFeed from './community/CommunityFeed.astro';
import { communityText } from '../i18n/community';
import { home } from '../i18n/home';
import { kqlFileName } from '../data/kql';
import { paths, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const c = communityText[lang].home;
const guide = home[lang].guide;
const kqlFile = `/recursos/${kqlFileName[lang]}`;
---

<section id="comunidad" class="section ground-surface">
  <div class="wrap">
    <div class="head" data-reveal>
      <div>
        <span class="eyebrow">{c.eyebrow}</span>
        <h2>{c.title}</h2>
      </div>
      <p>{c.note}</p>
    </div>
    <CommunityFeed lang={lang} limit={9} />
    <div class="magnet replica" data-reveal>
      <div class="magnet__copy">
        <span class="eyebrow">{guide.eyebrow}</span>
        <h3>{guide.title}</h3>
        <p>{guide.text}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={paths[lang].kql}>{guide.read}</a>
          <a class="btn btn--secondary" href={kqlFile} download={kqlFileName[lang]}>{guide.download}</a>
        </div>
      </div>
      <div class="magnet__file" aria-hidden="true">
        <span class="magnet__ext">.kql</span>
        <code>{guide.sample.map((line) => <><span>{line}</span><br /></>)}</code>
      </div>
    </div>
  </div>
</section>

<style>
  /* Guía gratuita (KQL) */
  .magnet {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: center;
    padding: 36px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--card);
  }
  .magnet__copy {
    grid-column: span 7;
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .magnet__copy h3 {
    font-size: var(--t3);
    line-height: 1.1;
  }
  .magnet__copy p {
    color: var(--muted);
  }
  .magnet__file {
    grid-column: 9 / span 4;
    position: relative;
    padding: 22px;
    border-radius: 18px;
    background: var(--ink);
    color: #c9cdd4;
    font: 400 12.5px/1.7 var(--mono);
    transform: rotate(2deg);
    transition: transform 0.4s;
  }
  .magnet__file code {
    display: block;
    white-space: pre;
  }
  :global([data-theme='dark']) .magnet__file {
    background: #000;
  }
  .magnet:hover .magnet__file {
    transform: rotate(0);
  }
  .magnet__ext {
    position: absolute;
    top: -12px;
    right: 18px;
    padding: 8px 10px;
    border-radius: 8px;
    background: var(--accent-fill);
    color: #fff;
    font: 600 13px/1 var(--mono);
  }

  @media (max-width: 1023px) {
    .magnet__copy,
    .magnet__file {
      grid-column: 1 / -1;
    }
    /* Una sola columna: con 12 columnas, solo los huecos (11 × 24 px) miden 264 px y desbordan
       la tarjeta cuando el contenido es más angosto (celulares de 320 px). */
    .magnet {
      grid-template-columns: 1fr;
      padding: 24px;
    }
  }
  @media (max-width: 639px) {
    .magnet__file {
      display: none;
    }
  }
</style>
