---
// Home completa en un idioma. La usan "/" (es) y "/en/" (en).
import Hero from './Hero.astro';
import Pulse from './Pulse.astro';
import Projects from './Projects.astro';
import HowIWork from './HowIWork.astro';
import Experience from './Experience.astro';
import Skills from './Skills.astro';
import Community from './Community.astro';
import Newsletter from './Newsletter.astro';
import About from './About.astro';
import { contact, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;

// Datos estructurados de la home (persona + blog)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Santiago Da Ros',
      jobTitle: 'Cloud Engineer',
      address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
      url: new URL(lang === 'es' ? '/' : '/en/', Astro.site).toString(),
      image: new URL('/og.png', Astro.site).toString(),
      knowsAbout: ['Microsoft Azure', 'Entra ID', 'Terraform', 'Azure Policy', 'Azure Site Recovery', 'FinOps', 'PowerShell', 'TypeScript'],
      sameAs: [contact.github, contact.linkedin],
    },
    {
      '@type': 'Blog',
      name: lang === 'es' ? 'Blog de Santiago Da Ros' : "Santiago Da Ros's blog",
      inLanguage: lang,
      author: { '@type': 'Person', name: 'Santiago Da Ros' },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<main id="main" tabindex="-1">
  <Hero lang={lang} />
  <Pulse lang={lang} interactive />
  <Projects lang={lang} />
  <HowIWork lang={lang} />
  <Experience lang={lang} />
  <Skills lang={lang} />
  <Community lang={lang} />
  <Newsletter lang={lang} />
  <About lang={lang} />
</main>
