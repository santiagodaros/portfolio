---
// Home completa en un idioma. La usan "/" (es) y "/en/" (en).
import Hero from './Hero.astro';
import Pulse from './Pulse.astro';
import Projects from './Projects.astro';
import HowIWork from './HowIWork.astro';
import Experience from './Experience.astro';
import Skills from './Skills.astro';
import Community from './Community.astro';
import Newsletter from './Newsletter.astro';
import About from './About.astro';
import type { Lang } from '../i18n';
import { personId, personJsonLd } from '../lib/seo';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;

// Datos estructurados de la home (persona + blog)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personJsonLd(lang, Astro.site!),
    {
      '@type': 'Blog',
      name: lang === 'es' ? 'Blog de Santiago Da Ros' : "Santiago Da Ros's blog",
      inLanguage: lang,
      author: { '@id': personId(Astro.site!) },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<main id="main" tabindex="-1">
  <Hero lang={lang} />
  <Pulse lang={lang} interactive />
  <Projects lang={lang} />
  <HowIWork lang={lang} />
  <Experience lang={lang} />
  <Skills lang={lang} />
  <Community lang={lang} />
  <Newsletter lang={lang} />
  <About lang={lang} />
</main>
