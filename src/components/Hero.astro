---
import { certs, home } from '../i18n/home';
import { communityText } from '../i18n/community';
import { getUpcomingTalks, talkDateLabel } from '../lib/talks';
import { paths, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = home[lang].hero;
// Pie de la foto: la próxima charla (sale de la colección talks; sin próxima, no hay pie)
const next = (await getUpcomingTalks(lang))[0];
let caption = '';
if (next) {
  const when = talkDateLabel(next, lang);
  // Sin fecha, la nota ("Fecha a confirmar") va en minúscula dentro de la frase
  const whenText = next.date ? when : when.charAt(0).toLowerCase() + when.slice(1);
  caption = [next.title.split(':')[0], next.event, whenText].filter(Boolean).join(' · ');
}
---

<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <span class="eyebrow">{t.eyebrow}</span>
      <h1>{t.titlePre}<em>{t.titleEm}</em></h1>
      <p class="hero__lead">{t.lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary" data-link="email" href="#contacto">
          {t.emailBtn}
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h8M5 2.5 8.5 6 5 9.5"></path></svg>
        </a>
        <a class="btn btn--secondary" href={paths[lang].cv} target="_blank" rel="noopener">{t.cvBtn}</a>
      </div>
      <div class="facts">
        {
          t.facts.map((f) => (
            <div>
              <strong>{f.id === 'certs' ? String(certs.length) : f.value}</strong>
              <span>{f.label}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="hero__photo">
      <div class="photo">
        <img src="/img/hero.webp" alt={t.photoAlt} width="1000" height="1250" fetchpriority="high" />
      </div>
      {next && <p class="photo__cap"><span class="status">{communityText[lang].home.nextTalk}</span> {caption}</p>}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 72px 0 88px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: center;
  }
  .hero__copy {
    grid-column: span 7;
    display: grid;
    gap: 22px;
  }
  .hero h1 {
    font-size: var(--t1);
    line-height: 1;
    letter-spacing: calc(var(--track) - 0.01em);
    max-width: 12.5ch;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .hero__lead {
    font-size: 20px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 44ch;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 40px;
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .facts strong {
    display: block;
    font: var(--display-weight) 34px/1 var(--display);
    letter-spacing: var(--track);
  }
  .facts span {
    font-size: 14px;
    color: var(--muted);
  }
  .hero__photo {
    grid-column: 9 / span 4;
    position: relative;
  }
  .photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 24px;
    overflow: hidden;
    background: var(--accent-fill);
  }
  .photo::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 30%;
    background: linear-gradient(transparent, rgb(31 45 230 / 0.35));
  }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    display: block;
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hero__photo:hover .photo img {
    transform: scale(1.03);
  }
  .photo__cap {
    margin-top: 14px;
    font-size: 13px;
    color: var(--muted);
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  @media (max-width: 1023px) {
    .hero__copy,
    .hero__photo {
      grid-column: 1 / -1;
    }
    .hero__photo {
      max-width: 420px;
    }
  }
  @media (max-width: 639px) {
    .hero {
      padding: 40px 0 64px;
    }
    .hero__lead {
      font-size: 17px;
    }
    .facts {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .facts strong {
      font-size: 26px;
    }
    .facts span {
      font-size: 12px;
    }
  }
</style>
