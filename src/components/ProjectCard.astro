---
// Tarjeta del mosaico de proyectos. Abre el modal del proyecto (#p-<id>).
// Es simple a propósito: estado, título, resumen y una métrica. La ilustración, las tecnologías y el resto
// del detalle están en el modal, así la grilla respira.
import { projectHash, type Project } from '../lib/projects';

interface Props {
  project: Project;
  more: string;
}
const { project: p, more } = Astro.props;
---

<a class="sol replica" href={`#${projectHash(p.id)}`} data-reveal>
  <div class="sol__top">
    <span class="sol__kind">{p.kind}</span>
    <span class:list={['status', { 'status--plan': p.statusTone === 'plan' }]}>{p.status}</span>
  </div>
  <h3>{p.title}</h3>
  <p>{p.summary}</p>
  {
    p.metric && (
      <div class="sol__metric">
        <strong>{p.metric.value}</strong>
        <span>{p.metric.label}</span>
      </div>
    )
  }
  <span class="sol__more">{more}</span>
</a>

<style>
  .sol {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 340px;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .sol:hover {
    transform: translateY(-2px);
    box-shadow: 0 24px 48px -32px rgb(0 0 0 / 0.45);
    color: var(--ink);
  }
  .sol__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    min-height: 24px;
  }
  .sol__kind {
    margin-right: auto;
    font-size: 13px;
    color: var(--muted);
  }
  .sol :global(.status) {
    white-space: nowrap;
  }
  .sol h3 {
    font-size: 26px;
    line-height: 1.12;
  }
  .sol p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }
  .sol__metric {
    display: grid;
    gap: 4px;
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .sol__metric strong {
    font: var(--display-weight) 28px/1.05 var(--display);
    letter-spacing: var(--track);
  }
  .sol__metric span {
    font-size: 13px;
    color: var(--muted);
  }
  .sol__more {
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
  }
  .sol:hover .sol__more {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 639px) {
    .sol {
      min-height: 0;
      padding: 24px;
    }
    .sol h3 {
      font-size: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sol {
      transition: none;
    }
    .sol:hover {
      transform: none;
    }
  }
</style>
