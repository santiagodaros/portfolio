---
// Tarjeta del mosaico de proyectos. Abre el modal del proyecto (#p-<id>).
import ProjectMini from './ProjectMini.astro';
import { projectHash, type Project } from '../lib/projects';

interface Props {
  project: Project;
  /** Para las tarjetas lg: 0 ocupa 7/12 y 1 ocupa 5/12. */
  lgIndex?: number;
  more: string;
}
const { project: p, lgIndex = 0, more } = Astro.props;
---

<a
  class:list={[
    'sol replica',
    `sol--${p.size}`,
    { 'sol--a': p.size === 'lg' && lgIndex === 0, 'sol--b': p.size === 'lg' && lgIndex === 1 },
  ]}
  href={`#${projectHash(p.id)}`}
  data-reveal
>
  <div class="sol__top">
    <span class="sol__kind">{p.kind}</span>
    <span class:list={['status', { 'status--plan': p.statusTone === 'plan' }]}>{p.status}</span>
  </div>
  <h3>{p.title}</h3>
  {p.mini && <ProjectMini mini={p.mini} />}
  <p>{p.summary}</p>
  <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
  {
    p.metric && (
      <div class="sol__metric">
        <strong>{p.metric.value}</strong>
        <span>{p.metric.label}</span>
      </div>
    )
  }
  <span class="sol__more">{more}</span>
</a>

<style>
  .sol {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .sol:hover {
    transform: translateY(-2px);
    box-shadow: 0 24px 48px -32px rgb(0 0 0 / 0.45);
    color: var(--ink);
  }
  .sol--a {
    grid-column: span 7;
  }
  .sol--b {
    grid-column: span 5;
  }
  .sol__top {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 24px;
  }
  .sol__kind {
    margin-right: auto;
    font-size: 13px;
    color: var(--muted);
  }
  .sol h3 {
    font-size: var(--t4);
    line-height: 1.15;
  }
  .sol--lg h3 {
    font-size: var(--t3);
  }
  .sol p {
    font-size: 15px;
    color: var(--muted);
  }
  .sol__metric {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .sol__metric strong {
    font: var(--display-weight) 26px/1 var(--display);
    letter-spacing: var(--track);
  }
  .sol--lg .sol__metric strong {
    font-size: 34px;
  }
  .sol__metric span {
    font-size: 13px;
    color: var(--muted);
  }
  .sol__more {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
  }
  .sol:hover .sol__more {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Tarjeta ancha (proyecto propio): ilustración al centro, métrica a la derecha */
  .sol--wide {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
    grid-template-areas:
      'top mini metric'
      'h mini metric'
      'p mini tags';
    column-gap: 28px;
    row-gap: 10px;
    align-items: start;
  }
  .sol--wide .sol__top {
    grid-area: top;
  }
  .sol--wide h3 {
    grid-area: h;
  }
  .sol--wide p {
    grid-area: p;
  }
  .sol--wide :global(.mini) {
    grid-area: mini;
    height: 132px;
  }
  .sol--wide .tags {
    grid-area: tags;
    align-self: end;
  }
  .sol--wide .sol__metric {
    grid-area: metric;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  @media (max-width: 1023px) {
    .sol,
    .sol--a,
    .sol--b {
      grid-column: span 6;
    }
    .sol--wide {
      grid-column: 1 / -1;
      grid-template-columns: 1fr;
      grid-template-areas: 'top' 'h' 'p' 'mini' 'metric' 'tags';
    }
    .sol--wide .sol__metric {
      flex-direction: row;
      align-items: baseline;
      gap: 8px;
    }
  }
  @media (max-width: 639px) {
    .sol,
    .sol--a,
    .sol--b {
      grid-column: 1 / -1;
    }
    .sol--lg :global(.mini) {
      height: 160px;
    }
    .sol__metric {
      flex-wrap: wrap;
    }
    .sol__metric strong,
    .sol--lg .sol__metric strong {
      font-size: 24px;
    }
  }
</style>
