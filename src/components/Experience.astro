---
import { home } from '../i18n/home';
import type { Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = home[lang].experience;
---

<section id="experiencias" class="section ground-ink">
  <div class="wrap">
    <div class="head" data-reveal>
      <div>
        <span class="eyebrow">{t.eyebrow}</span>
        <h2>{t.title}</h2>
      </div>
      <p>{t.note}</p>
    </div>
    <div class="xp">
      <figure class="xp__photo" data-reveal>
        <img src="/img/pitch.webp" alt={t.pitchAlt} width="1400" height="1179" loading="lazy" />
        <figcaption><span>{t.captionMeta}</span>{t.caption}</figcaption>
      </figure>
      <div class="xp__copy" data-reveal>
        <span class="eyebrow">{t.kicker}</span>
        <h3>{t.heading}</h3>
        <p>{t.text}</p>
        <ul class="xp__role">
          {
            t.role.map((r) => (
              <li>
                <svg aria-hidden="true"><use href="#converge" /></svg>
                <span><b>{r.label}</b> {r.text}</span>
              </li>
            ))
          }
        </ul>
        <div class="tags">{t.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
        <div class="xp__gallery">
          <span class="ph"><img src="/img/build-sq.webp" alt={t.buildAlt} width="800" height="800" loading="lazy" /></span>
          <span class="ph"><img src="/img/screen.webp" alt={t.screenAlt} width="800" height="800" loading="lazy" /></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .xp {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }
  .xp__photo {
    position: relative;
    grid-column: span 7;
    margin: 0;
    border-radius: 24px;
    overflow: hidden;
  }
  .xp__photo::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 35%;
    background: linear-gradient(transparent, rgb(31 45 230 / 0.35));
    pointer-events: none;
  }
  .xp__photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 7 / 6;
    object-fit: cover;
  }
  .xp__photo figcaption {
    position: absolute;
    z-index: 1;
    left: 20px;
    bottom: 20px;
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--accent-fill);
    color: #fff;
    font: 500 14px/1.3 var(--text);
  }
  .xp__photo figcaption span {
    font: 400 12px/1 var(--mono);
    opacity: 0.8;
  }
  .xp__copy {
    grid-column: 9 / span 4;
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .xp__copy h3 {
    font-size: var(--t3);
    line-height: 1.1;
  }
  .xp__copy p {
    color: color-mix(in srgb, currentColor 70%, transparent);
  }
  .xp__role {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xp__role li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 10px;
    font-size: 15px;
  }
  .xp__role svg {
    width: 22px;
    height: 22px;
    color: #8b93ff;
  }
  .xp__gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    width: 100%;
    margin-top: 8px;
  }
  .xp__gallery img {
    aspect-ratio: 1;
    object-fit: cover;
  }

  @media (max-width: 1023px) {
    .xp__photo,
    .xp__copy {
      grid-column: 1 / -1;
    }
  }
</style>
