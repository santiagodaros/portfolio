---
// Sección Blog de la home: artículo destacado + lista (artículos y los 3 posts de LinkedIn más recientes).
import { formatDate, getBlogIndex, getFeaturedArticle, articleHref, getReadingTime } from '../lib/blog';
import { blogText, tagLabel } from '../i18n/blog';
import { paths, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = blogText[lang];
const featured = await getFeaturedArticle(lang);
const items = await getBlogIndex(lang);
// En la home: los artículos propios y los 3 posts más recientes (la versión extendida va en el destacado)
const list = [...items.filter((i) => i.kind === 'article'), ...items.filter((i) => i.kind === 'post').slice(0, 3)];
// Texto grande de la portada: el título hasta los dos puntos
const coverTitle = featured?.data.title.split(':')[0];
---

<section id="blog" class="section ground-surface">
  <div class="wrap">
    <div class="head" data-reveal>
      <div>
        <span class="eyebrow">{t.home.eyebrow}</span>
        <h2>{t.home.title}</h2>
      </div>
      <p>{t.home.note}</p>
    </div>
    <div class="blog">
      {
        featured && (
          <a class="post--feat replica" data-reveal href={articleHref(featured)}>
            <div
              class:list={['post__cover', { 'post__cover--img': featured.data.cover }]}
              style={featured.data.cover ? `--cover: url(${featured.data.cover})` : undefined}
              aria-hidden="true"
            >
              <span class="big">{coverTitle}</span>
            </div>
            <div class="post__body">
              <div class="post__meta">
                <span class="tag">{featured.data.category}</span>
                <span>{t.featuredMeta(getReadingTime(featured.body))}</span>
              </div>
              <h3>{featured.data.title}</h3>
              <p class="muted">{featured.data.description}</p>
            </div>
          </a>
        )
      }
      <div class="posts">
        {
          list.map((i) => (
            <a
              class="post"
              data-reveal
              href={i.href}
              {...(i.external ? { target: '_blank', rel: 'noopener' } : {})}
              {...(i.inSpanish ? { hreflang: 'es' } : {})}
            >
              <div class="post__meta">
                <span class="tag">{tagLabel(i.tag, lang)}</span>
                <span>
                  {formatDate(i.date, lang)} · {t.kinds[i.kind]}
                </span>
              </div>
              <h3>{i.title}</h3>
            </a>
          ))
        }
        <a class="link all" href={paths[lang].blog}>{t.home.seeAll}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .blog {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
  }
  .post--feat {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.2s;
  }
  .post--feat:hover {
    transform: translateY(-2px);
    color: var(--ink);
  }
  .post__cover {
    height: 250px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    border-radius: 24px 24px 0 0;
    background: var(--ink);
    color: var(--bg);
  }
  :global([data-theme='dark']) .post__cover:not(.post__cover--img) {
    background: #000;
  }
  .post__cover--img {
    height: 300px;
    justify-content: flex-end;
    background-color: #0b0c0e;
    background-image: var(--cover);
    background-position: center top;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .post__cover .big {
    font: var(--display-weight) 40px/1 var(--display);
    letter-spacing: var(--track);
    color: #fff;
  }
  .post__body {
    display: grid;
    gap: 10px;
    padding: 26px 28px;
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    font-size: 13px;
    color: var(--muted);
  }
  .post__meta .tag {
    color: var(--accent);
  }
  .post--feat h3 {
    font-size: var(--t3);
    line-height: 1.12;
  }
  .posts {
    grid-column: 8 / span 5;
    display: flex;
    flex-direction: column;
  }
  .post {
    display: grid;
    gap: 6px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .post:first-child {
    padding-top: 0;
  }
  .post h3 {
    font-size: var(--t4);
    line-height: 1.2;
    transition: color 0.15s;
  }
  .post:hover h3 {
    color: var(--accent);
  }
  .all {
    align-self: flex-start;
    margin-top: 20px;
  }

  @media (max-width: 1023px) {
    .post--feat,
    .posts {
      grid-column: 1 / -1;
    }
  }
</style>
