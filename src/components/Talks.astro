---
import { home } from '../i18n/home';
import type { Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = home[lang].talks;
---

<section id="charlas" class="section">
  <div class="wrap">
    <div class="head" data-reveal>
      <div>
        <span class="eyebrow">{t.eyebrow}</span>
        <h2>{t.title}</h2>
      </div>
      <p>{t.note}</p>
    </div>
    <div class="talks">
      {
        t.items.map((x) => (
          <article class="talk replica" data-reveal>
            <a class="talk__visual" href={x.url} target="_blank" rel="noopener" aria-label={x.aria}>
              <img src={`/img/${x.image}.webp`} alt="" width="1280" height="720" loading="lazy" />
              <span class="talk__play" aria-hidden="true">
                <svg viewBox="0 0 20 20"><path d="M7 5.5v9l7.5-4.5z" /></svg>
              </span>
            </a>
            <div class="talk__body">
              <h3>{x.title}</h3>
              <p>{x.text}</p>
              <p class="talk__meta">{x.meta}</p>
              <div class="tags">{x.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
              <a class="talk__link" href={x.url} target="_blank" rel="noopener">{x.link}</a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .talks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .talk {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--card);
  }
  .talk__visual {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 22px 22px 0 0;
    background: #0b0c0e;
    text-decoration: none;
  }
  .talk__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .talk__visual:hover img {
    filter: brightness(1.08);
  }
  .talk__play {
    position: absolute;
    right: 14px;
    bottom: 14px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent-fill);
    box-shadow: 0 8px 20px -6px rgb(0 0 0 / 0.6);
    transition: transform 0.2s;
  }
  .talk__play svg {
    width: 20px;
    height: 20px;
    margin-left: 3px;
    fill: #fff;
  }
  .talk__visual:hover .talk__play {
    transform: scale(1.08);
  }
  .talk__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
  }
  .talk__body h3 {
    font-size: var(--t4);
    line-height: 1.18;
  }
  .talk__body p {
    font-size: 15px;
    color: var(--muted);
  }
  .talk__body .talk__meta {
    font-size: 14px;
  }
  .talk__link {
    margin-top: auto;
    padding-top: 10px;
    justify-self: start;
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }
  .talk__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 639px) {
    .talks {
      grid-template-columns: 1fr;
    }
  }
</style>
