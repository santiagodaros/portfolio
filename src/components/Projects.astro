---
import PortalFlow from './PortalFlow.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectModal from './ProjectModal.astro';
import { home } from '../i18n/home';
import { homePath, type Lang } from '../i18n';
import { getProjects, projectHash } from '../lib/projects';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = home[lang].projects;
const projects = await getProjects(lang);
const featured = projects.find((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
const labels = { close: t.close, ...t.sections };
const closeHref = `${homePath(lang)}#proyectos`;
let lgCount = 0;
---

<section id="proyectos" class="section">
  <div class="wrap">
    <div class="head" data-reveal>
      <div>
        <span class="eyebrow">{t.eyebrow}</span>
        <h2>{t.title}</h2>
      </div>
      <p>{t.note}</p>
    </div>

    {
      featured && (
        <article class="feature" data-reveal data-project-open={projectHash(featured.id)}>
          <div class="feature__copy">
            <div class="feature__top">
              <span class="feature__kind">{featured.kind}</span>
              <span class:list={['status', { 'status--plan': featured.statusTone === 'plan' }]}>{featured.status}</span>
            </div>
            <h3>{featured.title}</h3>
            <p>{featured.summary}</p>
            <div class="tags">{featured.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
            <a class="btn btn--secondary btn-more" href={`#${projectHash(featured.id)}`}>{t.more}</a>
            <div class="kpis">
              {
                featured.kpis.map((k) => (
                  <div>
                    <strong>{k.value}</strong>
                    <span>{k.label}</span>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="feature__ui">
            {featured.flow && <PortalFlow flow={featured.flow} />}
            {featured.flow && <p class="ui-note">{featured.flow.note}</p>}
          </div>
        </article>
      )
    }

    <div class="solutions">
      {rest.map((p) => <ProjectCard project={p} lgIndex={p.size === 'lg' ? lgCount++ : 0} more={t.more} />)}
    </div>
  </div>

  {projects.map((p) => <ProjectModal project={p} labels={labels} closeHref={closeHref} />)}
</section>

<style>
  .feature {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    padding: 40px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--card);
    cursor: pointer;
  }
  .feature__copy {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .feature__top {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 24px;
  }
  .feature__kind {
    margin-right: auto;
    font-size: 13px;
    color: var(--muted);
  }
  .feature__copy h3 {
    font-size: var(--t3);
    line-height: 1.08;
  }
  .feature__copy p {
    color: var(--muted);
  }
  .btn-more {
    align-self: flex-start;
    margin-top: 4px;
  }
  .kpis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .kpis strong {
    display: block;
    font: var(--display-weight) 28px/1 var(--display);
  }
  .kpis span {
    font-size: 13px;
    color: var(--muted);
  }
  .feature__ui {
    grid-column: 5 / span 8;
    align-self: stretch;
    display: flex;
    flex-direction: column;
  }
  .ui-note {
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }
  .solutions {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  @media (max-width: 1023px) {
    /* Una sola columna: con 12 columnas, solo los huecos (11 × 24 px) miden 264 px y
       desbordan la tarjeta cuando el contenido es más angosto (celulares de 320 px). */
    .feature {
      grid-template-columns: 1fr;
      padding: 24px;
    }
    .feature__copy,
    .feature__ui {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  // Modales de proyecto: <dialog> nativo + hash #p-<id> para links directos.
  // El scroll de la página se conserva: abrir y cerrar no la mueve.
  const html = document.documentElement;
  const dialogs = Array.from(document.querySelectorAll<HTMLDialogElement>('dialog.pmodal'));
  const byId = new Map(dialogs.map((d) => [d.id, d]));
  let ignoreNextPop = false;

  function lockScroll(on: boolean) {
    if (on) {
      const bar = window.innerWidth - html.clientWidth; // evita el salto por la barra de scroll
      html.style.paddingRight = bar > 0 ? `${bar}px` : '';
      html.style.overflow = 'hidden';
    } else {
      html.style.paddingRight = '';
      html.style.overflow = '';
    }
  }

  function open(id: string, push = true) {
    const d = byId.get(id);
    if (!d || d.open) return;
    d.showModal();
    lockScroll(true);
    if (push) history.pushState({ p: id }, '', `#${id}`);
  }

  dialogs.forEach((d) => {
    d.addEventListener('close', () => {
      lockScroll(false);
      if (!location.hash.startsWith('#p-')) return;
      if (history.state?.p) {
        ignoreNextPop = true;
        history.back();
      } else {
        history.replaceState(null, '', location.pathname + location.search);
      }
    });
    // Click en el fondo (fuera del panel) cierra
    d.addEventListener('click', (e) => {
      if (e.target === d) d.close();
    });
    d.querySelector('[data-close]')?.addEventListener('click', (e) => {
      e.preventDefault();
      d.close();
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const link = target.closest<HTMLAnchorElement>('a[href^="#p-"]');
    if (link) {
      e.preventDefault();
      open(link.getAttribute('href')!.slice(1));
      return;
    }
    // Toda la tarjeta destacada abre el modal (los links y botones propios no)
    const feature = target.closest<HTMLElement>('[data-project-open]');
    if (feature && !target.closest('a, button')) open(feature.dataset.projectOpen!);
  });

  addEventListener('popstate', () => {
    if (ignoreNextPop) {
      ignoreNextPop = false;
      return;
    }
    const id = location.hash.slice(1);
    if (byId.has(id)) open(id, false);
    else dialogs.forEach((d) => d.open && d.close());
  });

  // Link directo: /#p-portal
  if (byId.has(location.hash.slice(1))) open(location.hash.slice(1), false);
</script>
