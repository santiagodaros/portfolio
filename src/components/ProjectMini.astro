---
// Ilustración decorativa de una tarjeta del mosaico: terminal, notas, checklist o grafo.
// No lleva datos reales; es solo una referencia visual de cómo funciona la herramienta.
import type { Project } from '../lib/projects';

interface Props {
  mini: NonNullable<Project['mini']>;
}
const { mini } = Astro.props;
---

<div class="mini" aria-hidden="true">
  {
    mini.type === 'terminal' &&
      mini.lines.map((l) => (
        <div class="ln">
          <span class={l.tone}>{l.mark}</span>
          {l.text}
          {l.dim && <span class="mut">{l.dim}</span>}
        </div>
      ))
  }
  {
    mini.type === 'notes' &&
      mini.items.map((n) => (
        <div class="note">
          <b>{n.title}</b>
          <span class="mut">{n.meta}</span>
        </div>
      ))
  }
  {
    mini.type === 'checks' &&
      mini.items.map((c) => (
        <div class:list={['check', { done: c.done }]}>
          <span class="box" />
          <span>{c.text}</span>
        </div>
      ))
  }
  {
    mini.type === 'graph' && (
      <>
        {mini.top ? (
          <svg viewBox="0 0 100 100" preserveAspectRatio="none">
            <line x1="50" y1="22" x2="50" y2="48" />
            <line x1="50" y1="52" x2="18" y2="78" />
            <line x1="50" y1="52" x2="50" y2="78" />
            <line x1="50" y1="52" x2="82" y2="78" />
          </svg>
        ) : (
          <svg viewBox="0 0 100 100" preserveAspectRatio="none">
            <line x1="50" y1="32" x2="18" y2="74" />
            <line x1="50" y1="32" x2="50" y2="74" />
            <line x1="50" y1="32" x2="82" y2="74" />
          </svg>
        )}
        {mini.top && <span class="node" style="left:50%;top:10%;transform:translateX(-50%)">{mini.top}</span>}
        <span class="node node--core" style={`left:50%;top:${mini.top ? 42 : 18}%;transform:translateX(-50%)`}>
          {mini.core}
        </span>
        {mini.leaves[0] && <span class="node" style={`left:6%;top:${mini.top ? 74 : 70}%`}>{mini.leaves[0]}</span>}
        {
          mini.leaves[1] && (
            <span class="node" style={`left:50%;top:${mini.top ? 74 : 70}%;transform:translateX(-50%)`}>
              {mini.leaves[1]}
            </span>
          )
        }
        {mini.leaves[2] && <span class="node" style={`right:6%;top:${mini.top ? 74 : 70}%`}>{mini.leaves[2]}</span>}
      </>
    )
  }
</div>

<style is:global>
  .mini {
    position: relative;
    height: 150px;
    overflow: hidden;
    border-radius: 14px;
    background: #0b0c0e;
    color: #c9cdd4;
    border: 1px solid rgb(255 255 255 / 0.06);
    font: 400 12px/1.6 var(--mono);
  }
  [data-theme='dark'] .mini {
    background: #000;
  }
  .sol--lg .mini {
    height: 200px;
    font-size: 13px;
  }
  .mini .ln {
    display: flex;
    gap: 8px;
    padding: 0 14px;
  }
  .mini .ln:first-child {
    padding-top: 14px;
  }
  .mini .ok {
    color: #8b93ff;
  }
  .mini .mut {
    color: #8a919c;
  }
  .mini .note {
    display: flex;
    justify-content: space-between;
    margin: 10px 12px 0;
    padding: 7px 10px;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.06);
    color: #e6e8eb;
    font: 400 12px/1.4 var(--mono);
  }
  .mini .note .mut {
    color: #8b93ff;
  }
  .mini .check {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 3px 14px;
    color: #e6e8eb;
    font: 400 12px/1.4 var(--mono);
  }
  .mini .check:first-child {
    padding-top: 14px;
  }
  .mini .box {
    width: 13px;
    height: 13px;
    border-radius: 4px;
    border: 1.5px solid #6b7280;
  }
  .mini .done .box {
    background: #5b67ff;
    border-color: #5b67ff;
  }
  .mini .done span:last-child {
    text-decoration: line-through;
    color: #8a919c;
  }
  .mini .node {
    position: absolute;
    padding: 5px 9px;
    border-radius: 8px;
    background: #16181c;
    border: 1px solid rgb(255 255 255 / 0.14);
    color: #e6e8eb;
    font: 500 11px/1 var(--mono);
  }
  .mini .node--core {
    background: var(--accent-fill);
    border-color: var(--accent);
    color: #fff;
  }
  .mini svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .mini line {
    stroke: #6b7280;
    stroke-width: 1;
    stroke-dasharray: 3 3;
    opacity: 0.6;
  }
</style>
