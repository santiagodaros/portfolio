---
import Logo from './Logo.astro';
import { homePath, useUi, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  /** URL de la misma página en el otro idioma. Sin traducción, el botón de idioma no se muestra. */
  alternateHref?: string;
  /** Muestra el botón de búsqueda (paleta ⌘K, fase 8). */
  search?: boolean;
}
const { lang = 'es', alternateHref, search = false } = Astro.props;
const t = useUi(lang);

// Los anchors llevan el prefijo de la home para que funcionen también desde /articulos, etc.
const home = homePath(lang);
const links = [
  { id: 'proyectos', label: t.nav.projects },
  { id: 'blog', label: t.nav.blog },
  { id: 'charlas', label: t.nav.talks },
  { id: 'sobre-mi', label: t.nav.about },
];
const mobileLinks = [
  { id: 'proyectos', label: t.nav.projects },
  { id: 'experiencias', label: t.nav.experience },
  { id: 'stack', label: t.nav.stack },
  { id: 'blog', label: t.nav.blog },
  { id: 'charlas', label: t.nav.talks },
  { id: 'newsletter', label: t.nav.newsletter },
  { id: 'sobre-mi', label: t.nav.about },
];
---

<header class="nav">
  <div class="wrap nav__bar">
    <Logo href={home} label={t.homeAria} animated />

    <nav class="nav__links" aria-label={t.mainNavAria}>
      {links.map((l) => <a href={`${home}#${l.id}`} data-section={l.id}>{l.label}</a>)}
    </nav>

    <div class="nav__right">
      {
        search && (
          <button class="icon-btn" type="button" data-open-palette aria-label={t.searchAria} title={t.searchTitle}>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <circle cx="9" cy="9" r="5.5" />
              <path d="m13.2 13.2 4 4" />
            </svg>
          </button>
        )
      }
      {
        alternateHref && (
          <a class="lang-btn" href={alternateHref} hreflang={lang === 'es' ? 'en' : 'es'} lang={lang === 'es' ? 'en' : 'es'} aria-label={t.switchLangAria}>
            {t.switchLangText}
          </a>
        )
      }
      <button
        class="theme-btn"
        type="button"
        data-theme-toggle
        data-label-to-dark={t.themeToDark}
        data-label-to-light={t.themeToLight}
        aria-label={t.themeToDark}
      >
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="4" />
          <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M4 16l1.4-1.4M14.6 5.4 16 4" />
        </svg>
      </button>
      <a class="btn btn--primary nav__cta" data-link="email" href="#contacto">{t.cta}</a>
      <button
        class="icon-btn menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mnav"
        aria-label={t.menuOpen}
        data-label-open={t.menuOpen}
        data-label-close={t.menuClose}
      >
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 7h14M3 13h14" /></svg>
      </button>
    </div>
  </div>

  <nav class="mnav" id="mnav" aria-label={t.menuAria} hidden>
    <div class="wrap mnav__list">
      {mobileLinks.map((l) => <a href={`${home}#${l.id}`}>{l.label}</a>)}
      <a class="btn btn--primary" data-link="email" href="#contacto">{t.cta}</a>
    </div>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .nav__bar {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .nav__links {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 4px;
  }
  .nav__links a {
    position: relative;
    white-space: nowrap;
    padding: 10px 14px;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font: 500 15px/1 var(--text);
    transition: color 0.15s;
  }
  .nav__links a:hover,
  .nav__links a[aria-current='true'] {
    color: var(--ink);
  }
  .nav__links a[aria-current='true']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--accent);
  }
  .nav__right {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .icon-btn,
  .lang-btn,
  .theme-btn {
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    display: grid;
    place-items: center;
    cursor: pointer;
    text-decoration: none;
    transition:
      color 0.15s,
      background 0.15s;
  }
  .icon-btn:hover,
  .lang-btn:hover,
  .theme-btn:hover {
    color: var(--ink);
    background: var(--surface);
  }
  .icon-btn svg,
  .theme-btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }
  .lang-btn {
    font: 500 13px/1 var(--mono);
  }
  .nav__cta {
    height: 40px;
    padding: 0 18px;
    margin-left: 8px;
    font-size: 14px;
  }
  .menu-btn {
    display: none;
  }
  .mnav {
    border-top: 1px solid var(--line);
    background: var(--bg);
  }
  .mnav__list {
    display: grid;
    padding: 12px 0 20px;
  }
  .mnav__list a:not(.btn) {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    font: 500 20px/1 var(--display);
    letter-spacing: -0.02em;
  }
  .mnav__list .btn {
    margin-top: 18px;
    justify-content: center;
  }
  .mnav[hidden] {
    display: none;
  }

  @media (max-width: 1023px) {
    .nav__links {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
  @media (max-width: 639px) {
    .nav__bar {
      gap: 10px;
    }
    .nav__right {
      gap: 6px;
    }
    .nav__cta {
      display: none;
    }
    .icon-btn,
    .lang-btn,
    .theme-btn {
      width: 38px;
      height: 38px;
    }
  }
</style>

<script>
  // Tema: el valor inicial lo fija el script inline del <head> (Layout) antes de pintar.
  const root = document.documentElement;
  const themeBtns = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  function paintTheme(theme: string) {
    root.setAttribute('data-theme', theme);
    themeBtns.forEach((b) => {
      b.setAttribute('aria-label', (theme === 'dark' ? b.dataset.labelToLight : b.dataset.labelToDark) ?? '');
    });
  }
  paintTheme(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');

  themeBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      paintTheme(next);
      try {
        localStorage.setItem('sdr-theme', next);
      } catch {}
    })
  );

  // Sin preferencia guardada, acompaña los cambios del sistema.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem('sdr-theme');
    } catch {}
    if (saved !== 'light' && saved !== 'dark') paintTheme(e.matches ? 'dark' : 'light');
  });

  // Menú móvil
  const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const mnav = document.getElementById('mnav');
  function setMenu(open: boolean) {
    if (!menuBtn || !mnav) return;
    mnav.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', (open ? menuBtn.dataset.labelClose : menuBtn.dataset.labelOpen) ?? '');
  }
  menuBtn?.addEventListener('click', () => setMenu(Boolean(mnav?.hidden)));
  mnav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mnav && !mnav.hidden) {
      setMenu(false);
      menuBtn?.focus();
    }
  });

  // Link activo según la sección visible (solo tiene efecto en la home, donde existen los ids).
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav__links a[data-section]'));
  const byId = new Map(links.map((a) => [a.dataset.section as string, a]));
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const a = byId.get(e.target.id);
          if (!a) return;
          if (e.isIntersecting) {
            links.forEach((l) => l.removeAttribute('aria-current'));
            a.setAttribute('aria-current', 'true');
          } else if (a.getAttribute('aria-current')) {
            a.removeAttribute('aria-current');
          }
        });
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    byId.forEach((_a, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>
