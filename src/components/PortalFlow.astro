---
// Esquema animado del portal CSP: fuentes de solo lectura → portal → lo que ve el equipo.
// Es una ilustración: no muestra capturas ni datos de clientes.
import type { Project } from '../lib/projects';

interface Props {
  flow: NonNullable<Project['flow']>;
}
const { flow } = Astro.props;
---

<div class="flow" role="img" aria-label={flow.ariaLabel}>
  <div class="flow__col flow__col--in">
    <span class="flow__label">{flow.inLabel}</span>
    {flow.sources.map((s) => <div class="flow__node">{s}</div>)}
  </div>
  <div class="flow__core">
    <svg class="flow__mark" aria-hidden="true"><use href="#sdr" /></svg>
    <b>{flow.coreTitle}</b>
    <ul>{flow.coreItems.map((i) => <li>{i}</li>)}</ul>
    <span class="flow__badge">{flow.badge}</span>
  </div>
  <div class="flow__col flow__col--out">
    <span class="flow__label">{flow.outLabel}</span>
    {
      flow.outputs.map((o) => (
        <div class="flow__card">
          <i />
          {o}
        </div>
      ))
    }
  </div>
</div>

<style>
  .flow {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.15fr 1fr;
    align-items: stretch;
    min-height: 420px;
    padding: 22px;
    gap: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg);
  }
  .flow__col {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }
  .flow__label {
    margin-bottom: 4px;
    font: 500 12px/1 var(--mono);
    color: var(--muted);
  }
  .flow__col--out .flow__label {
    padding-left: 28px;
  }
  .flow__node,
  .flow__card {
    position: relative;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    font: 500 14px/1.2 var(--text);
  }
  .flow__col--in .flow__node {
    margin-right: 28px;
  }
  .flow__col--out .flow__card {
    margin-left: 28px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .flow__card i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
  }
  /* Conectores punteados que "corren" hacia el portal y desde el portal */
  .flow__node::after,
  .flow__card::before {
    content: '';
    position: absolute;
    top: 50%;
    width: 29px;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 12px);
    background-size: 12px 2px;
    animation: flowdash 1s linear infinite;
  }
  .flow__node::after {
    left: 100%;
  }
  .flow__card::before {
    right: 100%;
  }
  .flow__col--out .flow__card:nth-child(odd)::before {
    animation-delay: -0.5s;
  }
  @keyframes flowdash {
    to {
      background-position: 12px 0;
    }
  }
  .flow__core {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    padding: 24px 22px;
    border-radius: 16px;
    background: #0b0c0e;
    color: #eef0f3;
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 14%, transparent);
  }
  :global([data-theme='dark']) .flow__core {
    background: #000;
  }
  .flow__mark {
    width: 40px;
    height: 27px;
  }
  .flow__core b {
    font: 500 24px/1.1 var(--display);
    letter-spacing: -0.03em;
  }
  .flow__core ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 13.5px;
    color: #b7bcc5;
  }
  .flow__core li {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .flow__core li::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #5b67ff;
    transform: translateY(-2px);
  }
  .flow__badge {
    align-self: flex-start;
    margin-top: 4px;
    padding: 7px 10px;
    border-radius: 999px;
    background: var(--accent-fill);
    color: #fff;
    font: 500 12px/1 var(--mono);
  }

  @media (max-width: 1023px) {
    .flow {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .flow__col--in .flow__node,
    .flow__col--out .flow__card {
      margin: 0;
    }
    .flow__col--out .flow__label {
      padding: 0;
    }
    .flow__node::after,
    .flow__card::before {
      display: none;
    }
  }
</style>
