---
// Hub /comunidad (EN /en/community): la misma lista visual de la home, completa y con una URL por pestaña,
// filtro por área y descarga del CSV.
import CommunityFeed from './CommunityFeed.astro';
import { communityText } from '../../i18n/community';
import { getProfiles } from '../../data/profiles';
import { homePath, type Lang } from '../../i18n';
import type { TabId } from '../../lib/contributions';

interface Props {
  lang: Lang;
  /** Pestaña activa; sin ella, "Todo". */
  tab?: TabId;
}
const { lang, tab } = Astro.props;
const t = communityText[lang].hub;
const profiles = getProfiles(['sessionize', 'youtube', 'github', 'qa', 'learn', 'linkedin']);
---

<main id="main" tabindex="-1" class="hub">
  <header class="reader__top">
    <div class="wrap hub__topbar">
      <a class="link" href={homePath(lang)}>{t.back}</a>
      <span class="muted">{t.crumb}</span>
    </div>
  </header>

  <div class="wrap">
    <div class="hub__head">
      <h1>{t.title}</h1>
      <p class="hub__lead">{t.lead}</p>
      {
        profiles.length > 0 && (
          <div class="hub__profiles">
            <span class="hub__label">{t.profilesTitle}</span>
            <ul>
              {profiles.map((p) => <li><a class="link" href={p.url} target="_blank" rel="noopener">{p.label}</a></li>)}
            </ul>
          </div>
        )
      }
    </div>

    <CommunityFeed lang={lang} tab={tab} showAreas level={2} />

    <p class="muted hub__note">{t.csvNote}</p>
  </div>
</main>

<style>
  .hub {
    padding-bottom: 96px;
  }
  .hub__topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 56px;
    font-size: 14px;
  }
  .hub__head {
    display: grid;
    gap: 14px;
    margin: 48px 0 32px;
    max-width: 760px;
  }
  .hub__head h1 {
    font-size: var(--t1);
    line-height: 1.04;
  }
  .hub__lead {
    font-size: 19px;
    line-height: 1.5;
    color: var(--muted);
  }
  .hub__label {
    margin: 0;
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hub__profiles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin-top: 6px;
  }
  .hub__profiles ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }
  .hub__note {
    margin-top: 48px;
    font-size: 14px;
  }
  @media (max-width: 639px) {
    .hub__head {
      margin-top: 32px;
    }
  }
</style>
